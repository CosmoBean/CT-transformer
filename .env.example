# Copy this file to `.env` and fill in the values you need.

# Required if you want to generate fresh agentic reports or rerun review evaluation
# without cached responses.
CMU_LLM_GATEWAY_API_KEY=your_gateway_api_key_here

# Optional alternative name already supported by the gateway client.
ANTHROPIC_API_KEY=

# Optional if your Hugging Face repos are private.
HF_TOKEN=your_huggingface_token_here

# Optional if you want a different Hugging Face token env var name.
HUGGING_FACE_HUB_TOKEN=
